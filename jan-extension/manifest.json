{
  "manifest_version": 3,
  "name": "SK Jan Pyidaungsu Font",
  "version": "1.0.0",
  "description": "Use Pyidaungsu for Myanmar text in Jan without changing code blocks.",
  "content_scripts": [
    {
      "matches": [
        "http://tauri.localhost/*",
        "https://tauri.localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
