[Unit]
Description=MCP-only SOCKS egress via sk-hp LAN SSH
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=sk-dell-1
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:1082 -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 sk-hp
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
